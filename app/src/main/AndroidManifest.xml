<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".platform.SpatialApplication"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_spatial_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_spatial_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpatialChessTheme"
        tools:targetApi="31">

        <activity
            android:name=".platform.LaunchActivity"
            android:exported="true"
            android:theme="@style/Theme.SpatialChessTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Spatial Chess: one Form.Volumetric WindowContainer in Shared Space (no Stage). -->
            <meta-data android:name="pico.spatial.windowcontainer.id" android:value="SpatialChessBoard" />
            <!-- 2 = Form.Volumetric -->
            <meta-data android:name="pico.spatial.windowcontainer.style" android:value="2" />
            <!-- width x height x depth in meters: board (60 cm) + trays + front toolbar envelope -->
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize" android:value="1.3x0.62x1.0" />
            <meta-data android:name="pico.spatial.windowcontainer.defaultsize.unit" android:value="meters" />
            <meta-data android:name="pico.spatial.windowcontainer.resizetype" android:value="0" />
            <!-- 1 = uniform resize only, keeps board proportions -->
            <meta-data android:name="pico.spatial.windowcontainer.resizerestriction" android:value="1" />
            <!-- 2 = WorldScale.Fixed: the board keeps its physical size like a real table-top object -->
            <meta-data android:name="pico.spatial.windowcontainer.worldscaletype" android:value="2" />
            <meta-data android:name="pico.spatial.windowcontainer.captionbar" android:value="0" />
            <!-- no frosted glass behind the board -->
            <meta-data android:name="pico.spatial.windowcontainer.materialbackground" android:value="0" />
            <!-- 0 = VolumeAlignment.Gravity: base stays parallel to the floor / table -->
            <meta-data android:name="pico.spatial.windowcontainer.volumealignment" android:value="0" />
            <meta-data android:name="pico.spatial.windowcontainer.volumebasepanel" android:value="0" />
        </activity>

        <meta-data android:name="icon.3d.list" android:resource="@array/icon_3d_list" />
        <meta-data android:name="icon.sdf.list" android:resource="@array/icon_sdf_list" />
    </application>

</manifest>
